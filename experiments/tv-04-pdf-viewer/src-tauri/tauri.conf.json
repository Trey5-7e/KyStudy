{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KyStudy TV-04 PDF Experiment",
  "version": "0.1.0",
  "identifier": "io.github.kystudy.tv04",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KyStudy TV-04 PDF 技术实验",
        "width": 1180,
        "height": 860,
        "minWidth": 760,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost kystudy-pdf: http://kystudy-pdf.localhost; script-src 'self'; worker-src 'self' blob:; img-src 'self' data: blob:; style-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../tv-01-tauri-shell/src-tauri/icons/icon.ico"]
  }
}
